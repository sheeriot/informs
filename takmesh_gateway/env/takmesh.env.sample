# Takmesh Gateway Configuration
#
# NOTE: MQTT and TAK credentials are now managed by Django and pushed via Sync.
# This file only contains operational settings and file paths.
# Configure gateways through Django: Configuration > MQTT Gateways

# ============================================
# TLS Certificate Paths (inside container)
# ============================================
# These paths are defaults - actual paths come from Django/TakServer model
TAK_CERT_PATH=/opt/app/certs/client.pem
TAK_CA_PATH=/opt/app/certs/truststore.pem

# Set to true if TAK server certificate CN matches hostname
TAK_CHECK_HOSTNAME=false

# ============================================
# Redis Settings (Message Buffer Cache)
# ============================================
# Redis URL for message buffer storage
# Default connects to 'redis' service in docker-compose
REDIS_URL=redis://redis:6379/0

# ============================================
# Operational Settings
# ============================================
# Enable debug logging
DEBUG=false

# Seconds to wait before reconnecting after disconnect
RECONNECT_DELAY=5

# How long CoT markers stay valid (seconds)
COT_STALE_SECONDS=3600
